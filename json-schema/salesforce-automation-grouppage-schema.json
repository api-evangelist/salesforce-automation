{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/GroupPage",
  "title": "GroupPage",
  "type": "object",
  "properties": {
    "currentPageUrl": {
      "type": "string"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "memberCount": {
            "type": "integer"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PublicAccess",
              "PrivateAccess"
            ]
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "nextPageUrl": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}