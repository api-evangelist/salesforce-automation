              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) The SOQL query string (e.g., SELECT Id, Name FROM Account WHERE Industry = 'Technology')"
                }
              ],
              "variable": [
                {
                  "description": "Your Salesforce instance identifier",
