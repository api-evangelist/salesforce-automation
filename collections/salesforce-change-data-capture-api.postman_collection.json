  "info": {
    "_postman_id": "90d85593-8d5f-4c2e-adf8-2b09c5a9b704",
    "name": "Salesforce Change Data Capture API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API endpoints for managing Change Data Capture (CDC) channel subscriptions and retrieving change event metadata. CDC provides near-real-time notifications of Salesforce record changes (create, update, delete, undelete) as event messages. Subscribers consume events via CometD (Streaming API), Pub/Sub API, or Apex triggers. The REST endpoints manage which objects are enabled for CDC and provide event metadata.\n\nContact Support:\n Name: Salesforce Developer Support\n Email: developer@salesforce.com",
      "type": "text/plain"
    }
  }
