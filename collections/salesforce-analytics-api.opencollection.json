{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Analytics (CRM Analytics) REST API",
    "version": "63.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List datasets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/datasets",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search term to filter datasets by name"
              },
              {
                "name": "folderId",
                "value": "",
                "type": "query",
                "description": "Filter datasets by analytics app (folder) ID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of CRM Analytics datasets accessible to the current user. Supports filtering by folder, search term, and sort order."
        },
        {
          "info": {
            "name": "Get a dataset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/datasets/:datasetIdOrApiName",
            "params": [
              {
                "name": "datasetIdOrApiName",
                "value": "",
                "type": "path",
                "description": "The dataset ID or developer name"
              }
            ]
          },
          "docs": "Returns metadata for a specific CRM Analytics dataset."
        }
      ]
    },
    {
      "info": {
        "name": "Query",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute a SAQL query",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/query",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Executes a SAQL (Salesforce Analytics Query Language) query against CRM Analytics datasets. SAQL provides a SQL-like syntax for querying, aggregating, and transforming analytics data."
        }
      ]
    },
    {
      "info": {
        "name": "Dashboards",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List dashboards",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/dashboards",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search term to filter dashboards"
              },
              {
                "name": "folderId",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of CRM Analytics dashboards accessible to the current user."
        },
        {
          "info": {
            "name": "Get a dashboard",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/dashboards/:dashboardId",
            "params": [
              {
                "name": "dashboardId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns metadata and configuration for a specific CRM Analytics dashboard, including its widgets, steps, and layout."
        }
      ]
    },
    {
      "info": {
        "name": "Lenses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List lenses (explorations)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/lenses",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query"
              },
              {
                "name": "folderId",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of CRM Analytics lenses (saved explorations)."
        }
      ]
    },
    {
      "info": {
        "name": "Dataflows",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List dataflows",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/dataflows"
          },
          "docs": "Returns a list of CRM Analytics dataflows (recipes). Dataflows define the ETL process for loading data into analytics datasets."
        },
        {
          "info": {
            "name": "Get a dataflow",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/dataflows/:dataflowId",
            "params": [
              {
                "name": "dataflowId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the definition and metadata for a specific CRM Analytics dataflow."
        }
      ]
    },
    {
      "info": {
        "name": "Folders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List analytics apps (folders)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/folders"
          },
          "docs": "Returns a list of CRM Analytics applications (folders) that organize dashboards, lenses, and datasets."
        }
      ]
    }
  ],
  "bundled": true
}