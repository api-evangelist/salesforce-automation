          "name": "Create nested records in a single request",
          "request": {
            "name": "Create nested records in a single request",
            "description": {
              "content": "Creates a parent record and its related child records in a single request. Supports up to 200 records total with up to 5 levels of nesting. Useful for creating an Account with its Contacts and Opportunities in one call.",
              "type": "text/plain"
            },
            "url": {
