      "name": "SOSL",
      "description": {
        "content": "Salesforce Object Search Language searches",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "34bf08ad-eafc-41bc-a5ef-915eff39a659",
          "name": "Execute a SOSL search",
          "request": {
            "name": "Execute a SOSL search",
            "description": {
              "content": "Executes a SOSL (Salesforce Object Search Language) search across multiple objects. SOSL uses the Salesforce search index to find records by text, unlike SOQL which uses the database directly.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "q",
                  "value": "<string>",
                  "description": "(Required) The SOSL search string (e.g., FIND {Acme} IN ALL FIELDS RETURNING Account(Id, Name), Contact(Id, Name, Email))"
                }
              ],
              "variable": [
                {
                  "description": "Your Salesforce instance identifier",
                  "type": "any",
                  "value": "{{instance}}",
                  "key": "instance"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "e72ebfdb-9e31-421c-a28c-e2f6e7316cf9",
              "name": "Search results",
              "originalRequest": {
                "url": {
                  "path": [
                    "search"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [
                    {
