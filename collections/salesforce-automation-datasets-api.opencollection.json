{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Analytics (CRM Analytics) REST Actions Datasets API",
    "version": "63.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List datasets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/datasets",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query",
                "description": "Search term to filter datasets by name"
              },
              {
                "name": "folderId",
                "value": "",
                "type": "query",
                "description": "Filter datasets by analytics app (folder) ID"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "order",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of CRM Analytics datasets accessible to the current user. Supports filtering by folder, search term, and sort order."
        },
        {
          "info": {
            "name": "Get a dataset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/datasets/:datasetIdOrApiName",
            "params": [
              {
                "name": "datasetIdOrApiName",
                "value": "",
                "type": "path",
                "description": "The dataset ID or developer name"
              }
            ]
          },
          "docs": "Returns metadata for a specific CRM Analytics dataset."
        }
      ]
    }
  ],
  "bundled": true
}