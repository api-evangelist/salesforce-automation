{
  "opencollection": "1.0.0",
  "info": {
    "name": "Salesforce Analytics (CRM Analytics) REST Actions Lenses API",
    "version": "63.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://login.salesforce.com/services/oauth2/authorize",
      "accessTokenUrl": "https://login.salesforce.com/services/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Lenses",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List lenses (explorations)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.salesforce.com/services/data/v63.0/wave/lenses",
            "params": [
              {
                "name": "q",
                "value": "",
                "type": "query"
              },
              {
                "name": "folderId",
                "value": "",
                "type": "query"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "pageSize",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns a paginated list of CRM Analytics lenses (saved explorations)."
        }
      ]
    }
  ],
  "bundled": true
}