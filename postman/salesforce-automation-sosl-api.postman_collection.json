  "item": [
    {
      "name": "search",
      "item": [
        {
          "name": "Execute a SOSL search",
          "id": "bf4e9e84-c023-4367-9e81-de2a1a390e62",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/search?q=<string>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "description": "(Required) The SOSL search string (e.g., FIND {Acme} IN ALL FIELDS RETURNING Account(Id, Name), Contact(Id, Name, Email))",
                  "key": "q",
                  "value": "<string>"
                }
              ]
            },
            "description": "Executes a SOSL (Salesforce Object Search Language) search across multiple objects. SOSL uses the Salesforce search index to find records by text, unlike SOQL which uses the database directly."
          },
          "response": [
            {
              "id": "cc0b1225-7fac-4825-bf3e-2f7287f9206f",
              "name": "Search results",
